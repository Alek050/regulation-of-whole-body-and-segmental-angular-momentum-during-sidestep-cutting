! READ HERE
! Step1: Manually open one Theia.c3d file and select as active file.
! Step2: Visually detect movement events and fill in the frame numbers in the first four commands 'Event_Explict'.
! Step3: Fill in subject individual mass and height in commands 'Set_Subject_Mass' and 'Set_Subject_Height'.
! Step4: Replace the file path and names in the last third and second commands 'Export_Data_To_Ascii_File' and 'File_Save_As'.'
! Step5: Execute pipeline and it will automatically close the current file as it has been saved as Visula3D workspace.
! Step6: Open the next Theia.c3d file and repeat from Step2.

Event_Explicit
/EVENT_NAME=FootStrike_IC
/FRAME=
! /TIME=
;

Event_Explicit
/EVENT_NAME=FootOff_IC
/FRAME=
! /TIME=
;

Event_Explicit
/EVENT_NAME=FootStrike_OPP
/FRAME=
! /TIME=
;

Event_Explicit
/EVENT_NAME=FootOff_OPP
/FRAME=
! /TIME=
;

Set_Subject_Mass
! /CALIBRATION_FILE=
! /PROMPT=
! /PROMPT_SIZE=90
/WEIGHT=
/UNITS=kg
;

Set_Subject_Height
! /CALIBRATION_FILE=
! /PROMPT=
! /PROMPT_SIZE=90
/HEIGHT=
! /UNITS=m
;

Build_Model
! /CALIBRATION_FILE=
! /REBUILD_ALL_MODELS=FALSE
! /DISPLAY_RESULTS=TRUE
;

First_Derivative
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=Model
/SIGNAL_NAMES=CenterOfMass
/RESULT_TYPES=DERIVED
/RESULT_FOLDER=COM
! /RESULT_NAMES=
/RESULT_SUFFIX=_VEL
;

! compute the R for (r x mv)
Evaluate_Expression
/EXPRESSION=vector((Kinetic_Kinematic::LFT::CGPos::X - KINETIC_KINEMATIC::MODEL::CenterOfMass::X ),(Kinetic_Kinematic::LFT::CGPos::Y - KINETIC_KINEMATIC::MODEL::CenterOfMass::Y),(Kinetic_Kinematic::LFT::CGPos::Z - KINETIC_KINEMATIC::MODEL::CenterOfMass::Z))
/RESULT_NAME=LFT_R 
! /RESULT_TYPE=DERIVED
! /RESULT_FOLDER=PROCESSED
;

! compute mv
Evaluate_Expression
/EXPRESSION=(MODEL::SEGMENT::LFT::MASS)*(Kinetic_Kinematic::LFT::CGVel - DERIVED::COM::CENTEROFMASS_VEL )
/RESULT_NAME=LFT_mv
! /RESULT_TYPE=DERIVED
! /RESULT_FOLDER=PROCESSED
;

! compute rxmv
Evaluate_Expression
/EXPRESSION=cross(DERIVED::PROCESSED::LFT_R, DERIVED::PROCESSED::LFT_mv)
/RESULT_NAME=LFT_rxmv
! /RESULT_TYPE=DERIVED
! /RESULT_FOLDER=PROCESSED
;

Compute_Model_Based_Data
/RESULT_NAME=LFT_IW
/FUNCTION=ANGULAR_MOMENTUM
/SEGMENT=LFT
/REFERENCE_SEGMENT=LAB
! /RESOLUTION_COORDINATE_SYSTEM=LAB
! /USE_CARDAN_SEQUENCE=FALSE
! /NORMALIZATION=FALSE
! /NORMALIZATION_METHOD=
! /NORMALIZATION_METRIC=
! /NEGATEX=FALSE
! /NEGATEY=FALSE
! /NEGATEZ=FALSE
! /AXIS1=X
! /AXIS2=Y
! /AXIS3=Z
;

! compute rxmv+IW
Evaluate_Expression
/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::LFT_IW + DERIVED::PROCESSED::LFT_rxmv
/RESULT_NAME=LFT_IWrxmv
/RESULT_TYPE=DERIVED
/RESULT_FOLDER=Momentum_Contribution
;

! compute the R for (r x mv)
Evaluate_Expression
/EXPRESSION=vector((Kinetic_Kinematic::LSK::CGPos::X - KINETIC_KINEMATIC::MODEL::CenterOfMass::X ),(Kinetic_Kinematic::LSK::CGPos::Y - KINETIC_KINEMATIC::MODEL::CenterOfMass::Y),(Kinetic_Kinematic::LSK::CGPos::Z - KINETIC_KINEMATIC::MODEL::CenterOfMass::Z))
